PORT=3000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=secretpassword
SESSION_SECRET=inirahasiabanget
NODE_ENV=development

# Konfigurasi Keycloak
# URL dasar server Keycloak Anda (tanpa /auth)
KEYCLOAK_URL=http://localhost:8080
# Nama Realm yang Anda gunakan
KEYCLOAK_REALM=master
# Client ID yang Anda buat di Keycloak
KEYCLOAK_CLIENT_ID=twibbon-app
# Client Secret dari client Anda di Keycloak
KEYCLOAK_CLIENT_SECRET=secret-anda-disini

URL_PORTAL=https://google.com